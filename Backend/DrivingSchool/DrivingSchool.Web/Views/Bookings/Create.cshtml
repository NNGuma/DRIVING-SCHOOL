@model DrivingSchool.Web.ViewModels.CreateBookingViewModel
@{
 ViewData["Title"] = "Book Lesson";
}
<h1>Book: @Model.Course.Title</h1>
<form asp-action="Create" method="post">
    <input type="hidden" asp-for="CourseId" />
    <div class="form-group">
        <label>Instructor</label>
        <select asp-for="InstructorId" asp-items="Model.InstructorSelectList"
                class="form-control"></select>
    </div>
    <div class="form-group">
        <label>Start</label>
        <input asp-for="Start" class="form-control" type="datetime-local" />
    </div>
    <div class="form-group">
        <label>End</label>
        <input asp-for="End" class="form-control" type="datetime-local" />
    </div>
    <div class="form-group">
        <label>Payment Method</label>
        <select asp-for="Method" class="form-control">
            <option value="Card">Card</option>
            <option value="EFT">EFT</option>
            <option value="MobileMoney">Mobile Money</option>
        </select>
    </div>
    <div class="form-group">
        <label>Amount</label>
        <input name="Amount" class="form-control" />
    </div>
    <button class="btn btn-success" type="submit">Book & Pay</button>
</form>